{
  "name": "@hadidyapp/audio-sdk",
  "version": "0.1.0",
  "description": "Official JavaScript SDK for the Hadidy Audio Transcoding API — browser and Node.js 22+",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsd",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "msw": "^2.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "tsd": "^0.31.0"
  },
  "keywords": ["audio", "transcoding", "sdk", "hadidy", "api"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NileNinja/audio-sdk.git"
  },
  "homepage": "https://github.com/NileNinja/audio-sdk#readme"
}
